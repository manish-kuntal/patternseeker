PATTERN_API=http://127.0.0.1:8000
PATTERN_KEY=change-me
DEVICE_ID=windows-main
DEVICE_NAME=Manish Laptop

# Lightweight foreground-app sampling
POLL_SECONDS=15

# Expensive filesystem/Git work is throttled and never runs every app sample.
PROJECT_SCAN_SECONDS=300
FILE_SCAN_SECONDS=180
GIT_SCAN_SECONDS=300

# Only these roots are scanned when PROJECT_ROOTS is set.
PROJECT_ROOTS=C:\Users\manis\Desktop;C:\Users\manis\Documents;C:\Users\manis\PatternSeeker
AUTO_DISCOVER=true
MAX_DEPTH=3
SYSTEM_POLL_SECONDS=15
# Screen intelligence (local-only, screenshots are processed in memory and never stored)
SCREEN_INTELLIGENCE_ENABLED=true
SCREEN_INTELLIGENCE_INTERVAL=60
SCREEN_OCR_ENABLED=true
SCREEN_AI_ENABLED=false
SCREEN_AI_MODEL=qwen2.5vl:7b
SCREEN_SENSITIVE_TERMS=bank,password,otp,1password,bitwarden,keepass,paytm,phonepe,gpay,upi,incognito,private,login,signin

# Adaptive local vision safeguards
SCREEN_AI_COOLDOWN=120
SCREEN_AI_ON_CONTEXT_CHANGE=true
SCREEN_AI_MAX_SYSTEM_CPU=70
SCREEN_AI_MAX_SYSTEM_MEMORY=88
